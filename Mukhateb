<!DOCTYPE html>

<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تقييم تجربة المستخدم — تطبيق مخاطب</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<style>
:root {
--green: #3d2b7a;
--green-light: #5a3fa8;
--gold: #7b5ea7;
--gold-light: #a98de0;
--bg: #f4f2fa;
--card: #ffffff;
--text: #1c1c1c;
--muted: #7a7a7a;
--border: #ddd8f0;
--radio-active: #3d2b7a;
}

- { box-sizing: border-box; margin: 0; padding: 0; }

body {
font-family: ‘Tajawal’, sans-serif;
background: var(–bg);
color: var(–text);
min-height: 100vh;
}

/* Header */
.header {
background: linear-gradient(135deg, #2d1f6e 0%, #3d2b7a 50%, #5a3fa8 100%);
padding: 48px 24px 36px;
text-align: center;
position: relative;
overflow: hidden;
}
.header::before {
content: ‘’;
position: absolute;
top: -60px; left: -60px;
width: 220px; height: 220px;
border-radius: 50%;
background: rgba(100,60,200,0.18);
}
.header::after {
content: ‘’;
position: absolute;
bottom: -80px; right: -40px;
width: 260px; height: 260px;
border-radius: 50%;
background: rgba(255,255,255,0.06);
}
.header-badge {
display: inline-block;
background: rgba(160,120,240,0.22);
border: 1px solid rgba(180,140,255,0.5);
color: #c8aaff;
font-size: 12px;
font-weight: 700;
letter-spacing: 2px;
padding: 6px 18px;
border-radius: 20px;
margin-bottom: 18px;
text-transform: uppercase;
}
.header h1 {
color: #fff;
font-size: 28px;
font-weight: 800;
margin-bottom: 10px;
position: relative;
z-index: 1;
}
.header p {
color: rgba(255,255,255,0.72);
font-size: 14px;
line-height: 1.7;
max-width: 480px;
margin: 0 auto;
position: relative;
z-index: 1;
}

/* Progress */
.progress-bar {
height: 4px;
background: var(–border);
position: sticky;
top: 0;
z-index: 100;
}
.progress-fill {
height: 100%;
background: linear-gradient(90deg, #3d2b7a, #a076e8);
width: 0%;
transition: width 0.4s ease;
}

/* Form */
.form-container {
max-width: 680px;
margin: 0 auto;
padding: 32px 16px 80px;
}

/* Section */
.section {
margin-bottom: 12px;
animation: fadeUp 0.4s ease both;
}
@keyframes fadeUp {
from { opacity: 0; transform: translateY(16px); }
to { opacity: 1; transform: translateY(0); }
}

.section-header {
display: flex;
align-items: center;
gap: 12px;
margin-bottom: 16px;
padding: 18px 20px 0;
}
.section-num {
width: 32px; height: 32px;
border-radius: 50%;
background: var(–green);
color: #fff;
font-size: 13px;
font-weight: 700;
display: flex; align-items: center; justify-content: center;
flex-shrink: 0;
}
.section-title {
font-size: 16px;
font-weight: 700;
color: var(–green);
}

.card {
background: var(–card);
border-radius: 16px;
padding: 20px;
border: 1px solid var(–border);
box-shadow: 0 2px 12px rgba(0,0,0,0.04);
}

/* Question */
.question {
margin-bottom: 24px;
padding-bottom: 24px;
border-bottom: 1px solid var(–border);
}
.question:last-child {
margin-bottom: 0;
padding-bottom: 0;
border-bottom: none;
}
.question-text {
font-size: 14px;
font-weight: 600;
color: var(–text);
margin-bottom: 14px;
line-height: 1.6;
}
.required { color: #c0392b; margin-right: 3px; }

/* Radio options */
.options {
display: flex;
flex-direction: column;
gap: 8px;
}
.option {
display: flex;
align-items: center;
gap: 10px;
padding: 11px 14px;
border: 1.5px solid var(–border);
border-radius: 10px;
cursor: pointer;
transition: all 0.2s;
background: var(–bg);
}
.option:hover {
border-color: var(–green-light);
background: #f0ecfa;
}
.option input[type=“radio”],
.option input[type=“checkbox”] {
accent-color: var(–green);
width: 16px; height: 16px;
flex-shrink: 0;
}
.option.selected {
border-color: var(–green);
background: #ede9f8;
}
.option label {
font-size: 13.5px;
cursor: pointer;
color: var(–text);
flex: 1;
}

/* Scale */
.scale-wrapper { direction: ltr; }
.scale {
display: flex;
gap: 6px;
margin-bottom: 8px;
}
.scale-btn {
flex: 1;
padding: 10px 4px;
border: 1.5px solid var(–border);
border-radius: 8px;
background: var(–bg);
font-size: 13px;
font-weight: 600;
cursor: pointer;
transition: all 0.2s;
font-family: ‘Tajawal’, sans-serif;
color: var(–muted);
}
.scale-btn:hover { border-color: var(–green-light); color: var(–green); }
.scale-btn.active {
background: var(–green);
border-color: var(–green);
color: #fff;
}
.scale-labels {
display: flex;
justify-content: space-between;
font-size: 11px;
color: var(–muted);
direction: rtl;
}

/* NPS */
.nps-scale {
display: grid;
grid-template-columns: repeat(10, 1fr);
gap: 4px;
direction: ltr;
}
.nps-btn {
padding: 10px 4px;
border: 1.5px solid var(–border);
border-radius: 8px;
background: var(–bg);
font-size: 12px;
font-weight: 700;
cursor: pointer;
transition: all 0.2s;
font-family: ‘Tajawal’, sans-serif;
color: var(–muted);
}
.nps-btn:hover { border-color: var(–green); color: var(–green); }
.nps-btn.active { background: var(–green); border-color: var(–green); color: #fff; }

/* Textarea */
.form-textarea {
width: 100%;
padding: 12px 14px;
border: 1.5px solid var(–border);
border-radius: 10px;
font-family: ‘Tajawal’, sans-serif;
font-size: 13.5px;
color: var(–text);
background: var(–bg);
resize: vertical;
min-height: 80px;
transition: border 0.2s;
outline: none;
}
.form-textarea:focus { border-color: var(–green); background: #fff; }

/* Submit */
.submit-btn {
width: 100%;
padding: 16px;
background: var(–green);
color: #fff;
border: none;
border-radius: 14px;
font-family: ‘Tajawal’, sans-serif;
font-size: 16px;
font-weight: 700;
cursor: pointer;
transition: all 0.2s;
margin-top: 28px;
box-shadow: 0 4px 20px rgba(61,43,122,0.35);
}
.submit-btn:hover {
background: var(–green-light);
transform: translateY(-1px);
box-shadow: 0 6px 24px rgba(61,43,122,0.45);
}
.submit-btn:active { transform: translateY(0); }

/* Success */
.success-screen {
display: none;
text-align: center;
padding: 60px 24px;
}
.success-icon {
width: 80px; height: 80px;
background: #ede9f8;
border-radius: 50%;
display: flex; align-items: center; justify-content: center;
margin: 0 auto 24px;
font-size: 36px;
}
.success-screen h2 {
font-size: 22px;
font-weight: 800;
color: var(–green);
margin-bottom: 10px;
}
.success-screen p {
color: var(–muted);
font-size: 14px;
line-height: 1.7;
}

.note {
font-size: 12px;
color: var(–muted);
text-align: center;
margin-top: 16px;
line-height: 1.6;
}

/* Logo */
.header-logo-wrap {
display: flex;
align-items: center;
justify-content: center;
margin-bottom: 20px;
position: relative;
z-index: 1;
}
.header-logo {
width: 100px;
height: 100px;
object-fit: contain;
filter: drop-shadow(0 4px 16px rgba(0,0,0,0.25));
border-radius: 20px;
}
.header-badge {
position: relative;
z-index: 1;
}
.header h1 {
position: relative;
z-index: 1;
}
.header p {
position: relative;
z-index: 1;
}
</style>

