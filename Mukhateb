<script>
const answers = {};

// Radio options
document.querySelectorAll('.options[data-type="radio"]').forEach(group => {
group.querySelectorAll('.option').forEach(opt => {
const input = opt.querySelector('input');
opt.addEventListener('click', () => {
group.querySelectorAll('.option').forEach(o => o.classList.remove('selected'));
opt.classList.add('selected');
input.checked = true;
answers[input.name] = input.value;
updateProgress();
});
});
});

// Scale buttons
document.querySelectorAll('.scale[data-name]').forEach(scale => {
const name = scale.dataset.name;
scale.querySelectorAll('.scale-btn').forEach(btn => {
btn.addEventListener('click', () => {
scale.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('active'));
btn.classList.add('active');
answers[name] = btn.dataset.val;
updateProgress();
});
});
});

// NPS
document.querySelectorAll('.nps-scale[data-name]').forEach(scale => {
const name = scale.dataset.name;
scale.querySelectorAll('.nps-btn').forEach(btn => {
btn.addEventListener('click', () => {
scale.querySelectorAll('.nps-btn').forEach(b => b.classList.remove('active'));
btn.classList.add('active');
answers[name] = btn.dataset.val;
updateProgress();
});
});
});

// Textarea
document.querySelectorAll('.form-textarea').forEach(ta => {
ta.addEventListener('input', () => {
answers[ta.name] = ta.value;
});
});

function updateProgress() {
const required = ['q1','q2','q3','q4','q5','q6','q7','q8','q9','q10','q11','q12','q13','q14','q15','q16'];
const filled = required.filter(k => answers[k]).length;
document.getElementById('progressFill').style.width = (filled / required.length * 100) + '%';
}

async function submitForm() {
const required = ['q1','q2','q3','q4','q5','q6','q7','q8','q9','q10','q11','q12','q13','q14','q15','q16'];
const missing = required.filter(k => !answers[k]);
if (missing.length > 0) {
alert('يرجى الإجابة على جميع الأسئلة الإلزامية (المشار إليها بـ *)');
return;
}

// Show loading state
const btn = document.querySelector('.submit-btn');
btn.textContent = 'جاري الإرسال...';
btn.disabled = true;
btn.style.opacity = '0.7';

// Save to Firebase
const saved = await window.saveToFirebase(answers);

if (saved) {
document.getElementById('formContent').style.display = 'none';
document.getElementById('successScreen').style.display = 'block';
document.getElementById('progressFill').style.width = '100%';
window.scrollTo({ top: 0, behavior: 'smooth' });
} else {
btn.textContent = 'إرسال التقييم';
btn.disabled = false;
btn.style.opacity = '1';
alert('حدث خطأ أثناء الإرسال، يرجى المحاولة مرة أخرى');
}
}
</script>

